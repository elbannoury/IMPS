# ---------------------------------------------------------------------------
# IMPS environment configuration (copy to .env and fill in real values)
# ---------------------------------------------------------------------------
# Database -------------------------------------------------------------------
# Local development uses SQLite. For production switch prisma/schema.prisma
# provider to "postgresql" and point this at your Postgres/Supabase database.
DATABASE_URL="file:./dev.db"

# Authentication -------------------------------------------------------------
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Public site URL, used for canonical URLs, sitemap, email links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First platform owner (used by `npm run db:seed` only) -----------------------
SEED_OWNER_EMAIL="owner@imps.ma"
SEED_OWNER_PASSWORD="ChangeMe!2026"
SEED_DEMO_DATA="true"

# Storage --------------------------------------------------------------------
# "local" stores uploads in public/uploads (development only).
# Production should set this to "s3" or "supabase" and fill the keys below.
MEDIA_STORAGE="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Maps (optional — the map UI stays disabled until a key is configured) ------
NEXT_PUBLIC_MAP_PROVIDER=""            # "mapbox" | "google" | ""
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# Contact channels -----------------------------------------------------------
# Leave empty to hide the WhatsApp button. Numbers must be real and authorised.
NEXT_PUBLIC_WHATSAPP_NUMBER=""         # international format, no +, e.g. 2126XXXXXXXX
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL="contact@imps.ma"

# Email delivery (optional — notifications are in-app until configured) ------
EMAIL_PROVIDER=""                      # "resend" | "smtp" | ""
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# Analytics (optional) -------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=""
