// IMPS — relational data model.
//
// Local development/demo runs on SQLite so the project is runnable with zero
// external services. The model is written to be PostgreSQL-ready: for
// production change `provider` to "postgresql", point DATABASE_URL at your
// Postgres/Supabase instance and run `prisma migrate deploy`.
// Enumerations are stored as strings with app-level (zod) validation because
// SQLite has no native enum type; the same columns can be converted to native
// Postgres enums without changing application code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity, staff and access control
// ---------------------------------------------------------------------------

model Profile {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  fullName        String
  phone           String?
  locale          String    @default("fr")
  isStaff         Boolean   @default(false)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  roleId          String?
  role            Role?     @relation(fields: [roleId], references: [id])
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions             Session[]
  createdProperties    Property[]             @relation("PropertyCreatedBy")
  assignedProperties   Property[]             @relation("PropertyAssignedTo")
  createdLeads         Lead[]                 @relation("LeadCreatedBy")
  assignedLeads        Lead[]                 @relation("LeadAssignedTo")
  leadNotes            LeadNote[]
  assignedAppointments ViewingAppointment[]
  assignedTasks        StaffTask[]
  verifications        PropertyVerification[]
  submittedReviews     PublicationReview[]    @relation("ReviewSubmittedBy")
  decidedReviews       PublicationReview[]    @relation("ReviewDecidedBy")
  articles             Article[]
  developments         Development[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  savedProperties      SavedProperty[]
  savedSearches        SavedSearch[]
  sourcingLeads        PropertyLead[]         @relation("SourcingAssignedTo")
  createdSourcing      PropertyLead[]         @relation("SourcingCreatedBy")
  contactAttempts      LeadContactAttempt[]

  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // owner | manager | collector | reviewer | crm | editor | analyst
  nameFr      String
  nameAr      String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  profiles    Profile[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  label String
  group String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([profileId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Geography and taxonomy
// ---------------------------------------------------------------------------

model City {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameFr        String
  nameAr        String
  region        String?
  descriptionFr String?
  descriptionAr String?
  heroImage     String?
  latitude      Float?
  longitude     Float?
  isPublished   Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  neighborhoods Neighborhood[]
  properties    Property[]
  sourcingLeads PropertyLead[]
  articles      Article[]
  developments  Development[]

  @@index([isPublished, sortOrder])
}

model Neighborhood {
  id            String   @id @default(cuid())
  cityId        String
  city          City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  slug          String
  nameFr        String
  nameAr        String
  descriptionFr String?
  descriptionAr String?
  latitude      Float?
  longitude     Float?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  properties    Property[]
  sourcingLeads PropertyLead[]
  developments  Development[]

  @@unique([cityId, slug])
  @@index([cityId, isPublished])
}

/// Configurable category tree: residential (apartment, villa, riad, house,
/// land...), commercial (office, retail, warehouse...), land.
model PropertyCategory {
  id        String             @id @default(cuid())
  slug      String             @unique
  nameFr    String
  nameAr    String
  /// residential | commercial | land | development
  kind      String
  icon      String?
  parentId  String?
  parent    PropertyCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  PropertyCategory[] @relation("CategoryTree")
  isActive  Boolean            @default(true)
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  properties    Property[]
  sourcingLeads PropertyLead[]

  @@index([kind, isActive, sortOrder])
}

model Amenity {
  id       String  @id @default(cuid())
  slug     String  @unique
  labelFr  String
  labelAr  String
  /// outdoor | building | interior | commercial | land
  group    String  @default("interior")
  icon     String?
  isActive Boolean @default(true)

  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([amenityId])
}

// ---------------------------------------------------------------------------
// Properties, offers and media
// ---------------------------------------------------------------------------

model Property {
  id        String @id @default(cuid())
  reference String @unique
  slug      String @unique

  titleFr       String
  titleAr       String?
  descriptionFr String
  descriptionAr String?

  categoryId      String
  category        PropertyCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// sale | rent
  transactionType String

  cityId         String
  city           City          @relation(fields: [cityId], references: [id], onDelete: Restrict)
  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)

  addressLine       String?
  /// exact | approximate | city_only
  locationPrecision String  @default("approximate")
  latitude          Float?
  longitude         Float?

  /// Denormalised search/read model, kept in sync with the active offer.
  /// PropertyOffer remains the source of truth (see src/lib/offers.ts).
  primaryPrice      Int?
  primaryRentPeriod String?

  builtArea       Float?
  landArea        Float?
  bedrooms        Int?
  bathrooms       Int?
  floors          Int?
  floorNumber     Int?
  parkingSpaces   Int?
  yearBuilt       Int?
  /// new | excellent | good | needs_work
  condition       String?
  furnished       Boolean?
  hasTerrace      Boolean  @default(false)
  streetFrontage  Float?
  occupancyStatus String?

  /// Recorded by staff only when documented — never estimated.
  documentedMonthlyRent Int?
  annualOperatingCosts  Int?

  /// Publication & transaction lifecycle:
  /// draft | in_review | published | reserved | sold | rented | unavailable | expired | archived | rejected
  status        String @default("draft")
  /// Sourcing pipeline stage: discovered | contacted | collecting | verification |
  /// review | approved | published | rejected | unresponsive | duplicate | not_authorized | unavailable
  sourcingStage String @default("collecting")

  isFeatured            Boolean @default(false)
  /// none | verbal | written | documented
  publicationPermission String  @default("none")
  dataSource            String?
  internalNotes         String?

  verificationLevel       String    @default("unverified") // unverified | identity_checked | availability_confirmed | documents_reviewed | legally_verified
  availabilityConfirmedAt DateTime?
  publishedAt             DateTime?
  archivedAt              DateTime?
  expiresAt               DateTime?
  nextAvailabilityCheckAt DateTime?

  metaTitleFr       String?
  metaDescriptionFr String?
  metaTitleAr       String?
  metaDescriptionAr String?

  viewCount    Int      @default(0)
  isSample     Boolean  @default(false)
  createdById  String?
  createdBy    Profile? @relation("PropertyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   Profile? @relation("PropertyAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  offers        PropertyOffer[]
  media         PropertyMedia[]
  amenities     PropertyAmenity[]
  verifications PropertyVerification[]
  reviews       PublicationReview[]
  leads         Lead[]
  appointments  ViewingAppointment[]
  savedBy       SavedProperty[]
  tasks         StaffTask[]
  statusHistory PropertyStatusHistory[]
  sourcingLeads PropertyLead[]

  @@index([status, transactionType])
  @@index([cityId, status])
  @@index([categoryId, status])
  @@index([isFeatured, status])
  @@index([publishedAt])
  @@index([primaryPrice])
  @@index([deletedAt])
}

model PropertyOffer {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// sale | rent
  transactionType String
  price           Int // whole MAD
  currency        String   @default("MAD")
  /// month | day | year — required for rentals, null for sales
  rentPeriod      String?
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId, isActive])
  @@index([price])
}

model PropertyMedia {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  /// image | video | tour | floorplan | document
  kind       String   @default("image")
  /// public | private (private media is never exposed on public routes)
  visibility String   @default("public")
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  captionFr  String?
  captionAr  String?
  altFr      String?
  altAr      String?
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  @@index([propertyId, sortOrder])
}

model PropertyStatusHistory {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  reason     String?
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
}

// ---------------------------------------------------------------------------
// Sourcing, owners and verification
// ---------------------------------------------------------------------------

model PropertyLead {
  id           String  @id @default(cuid())
  code         String  @unique
  title        String
  /// owner | agency | developer | referral | walk_in | web | other
  sourceType   String  @default("owner")
  sourceDetail String?

  cityId          String?
  city            City?             @relation(fields: [cityId], references: [id], onDelete: SetNull)
  neighborhoodId  String?
  neighborhood    Neighborhood?     @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        PropertyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactionType String?

  askingPrice         Int?
  description         String?
  /// discovered | contacted | collecting | verification | review | approved |
  /// published | rejected | unresponsive | duplicate | not_authorized | unavailable
  stage               String  @default("discovered")
  /// none | verbal | written | documented
  permissionToPublish String  @default("none")
  missingInfo         String? // JSON array of labels
  internalNotes       String?

  assignedToId String?
  assignedTo   Profile? @relation("SourcingAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    Profile? @relation("SourcingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  firstContactAt      DateTime?
  nextFollowUpAt      DateTime?
  convertedPropertyId String?
  convertedProperty   Property? @relation(fields: [convertedPropertyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerContacts OwnerContact[]
  attempts      LeadContactAttempt[]

  @@index([stage])
  @@index([assignedToId, nextFollowUpAt])
}

model OwnerContact {
  id             String        @id @default(cuid())
  propertyLeadId String?
  propertyLead   PropertyLead? @relation(fields: [propertyLeadId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  role           String? // owner | agent | developer | notary
  isPrimary      Boolean       @default(false)
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([propertyLeadId])
}

model LeadContactAttempt {
  id             String       @id @default(cuid())
  propertyLeadId String
  propertyLead   PropertyLead @relation(fields: [propertyLeadId], references: [id], onDelete: Cascade)
  staffId        String?
  staff          Profile?     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  channel        String // call | whatsapp | email | visit
  outcome        String // reached | no_answer | callback | refused | wrong_number
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([propertyLeadId, createdAt])
}

model PropertyVerification {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// availability | identity | ownership_document | legal | price | media
  type         String
  /// passed | failed | partial | pending
  result       String
  notes        String?
  evidenceRef  String?
  verifiedById String?
  verifiedBy   Profile?  @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime  @default(now())
  nextCheckAt  DateTime?

  @@index([propertyId, type])
}

model PublicationReview {
  id            String    @id @default(cuid())
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  submittedById String?
  submittedBy   Profile?  @relation("ReviewSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewerId    String?
  reviewer      Profile?  @relation("ReviewDecidedBy", fields: [reviewerId], references: [id], onDelete: SetNull)
  /// pending | approved | rejected | changes_requested
  decision      String    @default("pending")
  notes         String?
  snapshotJson  String?
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  @@index([propertyId, createdAt])
  @@index([decision])
}

// ---------------------------------------------------------------------------
// Customer relationship management
// ---------------------------------------------------------------------------

model Lead {
  id           String    @id @default(cuid())
  code         String    @unique
  propertyId   String?
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  name         String
  phone        String?
  email        String?
  message      String?
  /// website_form | whatsapp | phone | viewing_form | report | other
  source       String    @default("website_form")
  locale       String    @default("fr")
  /// new | attempted | contacted | qualified | viewing_scheduled |
  /// viewing_completed | negotiating | converted | lost | unresponsive
  status       String    @default("new")
  priority     String    @default("normal") // low | normal | high
  assignedToId String?
  assignedTo   Profile?  @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    Profile?  @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notes        String?
  followUpAt   DateTime?
  ipHash       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notesList    LeadNote[]
  appointments ViewingAppointment[]

  @@index([status, createdAt])
  @@index([assignedToId, followUpAt])
  @@index([propertyId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Profile? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model ViewingAppointment {
  id           String    @id @default(cuid())
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  visitorName  String
  visitorPhone String?
  visitorEmail String?
  requestedAt  DateTime
  /// requested | confirmed | rescheduled | cancelled | completed | no_show
  status       String    @default("requested")
  assignedToId String?
  assignedTo   Profile?  @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  staffNotes   String?
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, requestedAt])
  @@index([propertyId, requestedAt])
}

model StaffTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  /// property | lead | appointment | sourcing | general
  entityType  String?
  entityId    String?
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    Profile?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  dueAt       DateTime?
  priority    String    @default("normal")
  /// open | done | cancelled
  status      String    @default("open")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([assigneeId, status, dueAt])
}

model Notification {
  id        String   @id @default(cuid())
  profileId String? // null = broadcast to all staff
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([profileId, isRead, createdAt])
}

// ---------------------------------------------------------------------------
// Public accounts
// ---------------------------------------------------------------------------

model SavedProperty {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([profileId, propertyId])
  @@index([profileId])
}

model SavedSearch {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name          String
  queryJson     String
  alertsEnabled Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([profileId])
}

model EmailToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  profileId String
  type      String // verify_email | reset_password
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([profileId, type])
}

// ---------------------------------------------------------------------------
// Editorial and developments
// ---------------------------------------------------------------------------

model ArticleCategory {
  id       String    @id @default(cuid())
  slug     String    @unique
  nameFr   String
  nameAr   String
  articles Article[]
}

model Article {
  id              String           @id @default(cuid())
  slug            String           @unique
  titleFr         String
  titleAr         String?
  excerptFr       String
  excerptAr       String?
  bodyFr          String
  bodyAr          String?
  categoryId      String?
  category        ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cityId          String?
  city            City?            @relation(fields: [cityId], references: [id], onDelete: SetNull)
  coverImage      String?
  /// draft | review | published | archived
  status          String           @default("draft")
  isEditorial     Boolean          @default(true)
  authorId        String?
  author          Profile?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, publishedAt])
}

model Development {
  id                 String        @id @default(cuid())
  slug               String        @unique
  nameFr             String
  nameAr             String?
  descriptionFr      String
  descriptionAr      String?
  cityId             String
  city               City          @relation(fields: [cityId], references: [id], onDelete: Restrict)
  neighborhoodId     String?
  neighborhood       Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  developerName      String?
  /// planned | under_construction | delivered
  constructionStatus String        @default("planned")
  deliveryDate       DateTime?
  coverImage         String?
  /// draft | published | archived
  status             String        @default("draft")
  isFeatured         Boolean       @default(false)
  isSample           Boolean       @default(false)
  createdById        String?
  createdBy          Profile?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  units DevelopmentUnit[]

  @@index([status, cityId])
}

model DevelopmentUnit {
  id            String      @id @default(cuid())
  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)
  code          String
  unitType      String
  bedrooms      Int?
  bathrooms     Int?
  area          Float?
  priceFrom     Int?
  floorPlanUrl  String?
  /// available | reserved | sold
  status        String      @default("available")

  @@index([developmentId])
}

// ---------------------------------------------------------------------------
// Platform operations
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // property.publish, property.price_change, staff.role_change, ...
  entityType String
  entityId   String
  summary    String
  beforeJson String?
  afterJson  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

model SiteSetting {
  key       String   @id
  value     String
  group     String   @default("general")
  label     String?
  updatedAt DateTime @updatedAt
}
